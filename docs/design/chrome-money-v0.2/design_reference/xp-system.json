{
  "meta": {
    "name": "OPPS — XP & Leveling System",
    "version": "1.0.0",
    "updated": "2026-06-17",
    "summary": "Single source of truth for experience (XP) awards and the level-1→100 progression curve. Read by gameplay systems to award XP and resolve level-ups.",
    "currencies": {
      "xp": "Experience — drives player LEVEL and rank title. Permanent, never spent.",
      "clout": "Street respect shown on leaderboards/log — separate from XP (tracked elsewhere)."
    },
    "howToUse": "On any qualifying action, add the matching value from actionXp to the player total, then advance level while total >= levels[next].totalXpToReach. Ranges (lo/hi) should roll uniformly unless a system specifies otherwise.",
    "curve": {
      "anchors": {
        "1->2": 5,
        "2->3": 20,
        "3->4": 40,
        "4->5": 100
      },
      "formula": "xpToNext(L) = round_nice( 100 * (L/4)^2 ) for L>=5; anchors hard-set for L1-4.",
      "walls": "Step into every 10th level x1.5 (extra grind). Major milestone walls (25/50/75/100) x2.0.",
      "milestones": [
        10,
        25,
        50,
        75,
        100
      ],
      "totalXpToMax": 2245525
    }
  },
